# Public image asset URL emitted into the static site.
# Defaults match the RustFS bucket used by this archive.
PUBLIC_S3_ASSET_ENDPOINT=https://objects.janpeterdhalle.com
PUBLIC_S3_ASSET_BUCKET=wilhalla-vake-blog
# Optional prefix inside the bucket, before /archive-images.
PUBLIC_S3_ASSET_PREFIX=
# Optional complete override, e.g. https://cdn.example.com/wilhalla-vake-blog
PUBLIC_S3_ASSET_BASE_URL=
# Set to false only for local builds that should use checked-out local images.
PUBLIC_USE_REMOTE_IMAGE_ASSETS=true

# Upload script settings (not embedded in the site):
S3_ALIAS=rustfs-blog
S3_BUCKET=wilhalla-vake-blog
S3_PREFIX=
