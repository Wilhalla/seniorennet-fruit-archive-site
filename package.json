{
  "name": "site",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "build:compressed": "astro check && astro build && pnpm compressStatic",
    "test": "vitest run",
    "preview": "astro preview --host 127.0.0.1",
    "extract": "tsx scripts/extract-archive.ts",
    "materialize": "tsx scripts/materialize-post-files.ts",
    "repairEncoding": "tsx scripts/repair-encoding.ts",
    "prepareData": "pnpm extract && pnpm copyImages && pnpm materialize && pnpm clientData",
    "copyImages": "tsx scripts/copy-images.ts",
    "clientData": "tsx scripts/build-client-data.ts",
    "compressStatic": "tsx scripts/compress-static.ts",
    "semanticAtlas": ".venv/bin/python scripts/semantic_atlas.py && .venv/bin/python scripts/topic_calendar.py",
    "imageAtlas": ".venv/bin/python scripts/image_atlas.py && .venv/bin/python scripts/species_atlas.py",
    "imageAtlas:bg": "nohup sh -c '.venv/bin/python scripts/image_atlas.py && .venv/bin/python scripts/species_atlas.py' > image-atlas.log 2>&1 & echo $! > image-atlas.pid",
    "speciesAtlas": ".venv/bin/python scripts/species_atlas.py",
    "topicCalendar": ".venv/bin/python scripts/topic_calendar.py",
    "searchIndex": "tsx scripts/build-search-index.ts",
    "uploadImages": "bash scripts/upload-public-images.sh",
    "uploadImages:bg": "bash scripts/upload-public-images-bg.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "@astrojs/react": "^5.0.5",
    "@astrojs/vercel": "^10.0.8",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@fontsource/anton": "^5.2.7",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.26",
    "astro": "^6.3.8",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.15.0",
    "minisearch": "^7.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "3.8.0",
    "shadcn": "^4.8.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "agentation": "^3.0.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "type": "module"
}
