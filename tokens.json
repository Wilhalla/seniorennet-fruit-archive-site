{
  "$description": "Design tokens are sourced from Tailwind v4 @theme in theme.css. This file intentionally references token names only, so colors and sizing are not duplicated outside the Tailwind theme.",
  "colors": {
    "midnightNavy": { "$value": "theme.color.midnight-navy" },
    "deepCosmos": { "$value": "theme.color.deep-cosmos" },
    "heroGradient": { "$value": "theme.color.hero-gradient" },
    "blueGlowRadial": { "$value": "theme.color.blue-glow-radial" },
    "iceVeil": { "$value": "theme.color.ice-veil" },
    "ghostCanvas": { "$value": "theme.color.ghost-canvas" },
    "pureSurface": { "$value": "theme.color.pure-surface" },
    "slateInk": { "$value": "theme.color.slate-ink" },
    "chartreusePulse": { "$value": "theme.color.chartreuse-pulse" }
  },
  "spacing": {
    "shell": { "$value": "theme.spacing.8" },
    "section": { "$value": "theme.spacing.14" },
    "page": { "$value": "theme.container.page" },
    "readable": { "$value": "theme.container.readable" }
  },
  "radius": {
    "card": { "$value": "theme.radius.2xl" },
    "panel": { "$value": "theme.radius.3xl" },
    "pill": { "$value": "theme.radius.pill" }
  },
  "shadow": {
    "soft": { "$value": "theme.shadow.soft" },
    "blue": { "$value": "theme.shadow.blue" },
    "insetIce": { "$value": "theme.shadow.inset-ice" }
  }
}
