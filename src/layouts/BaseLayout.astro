---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import SiteHeader from '../components/SiteHeader'
import { s3AssetBaseUrl, useRemoteImageAssets } from '../lib/assetUrls'
import {
  absoluteMetadataUrl,
  cleanMetadataText,
  configuredSiteUrl,
  defaultDescription,
  defaultSocialImage,
  metadataText,
  siteName,
} from '../lib/metadata'

type Props = {
  title?: string
  description?: string
  image?: string
  imageAlt?: string
  canonicalUrl?: string
  type?: 'website' | 'article'
  publishedTime?: string
  modifiedTime?: string
  hideFooter?: boolean
}

const {
  title = siteName,
  description = defaultDescription,
  image = defaultSocialImage,
  imageAlt,
  canonicalUrl,
  type = 'website',
  publishedTime,
  modifiedTime,
  hideFooter = false,
} = Astro.props

const metadataBase = configuredSiteUrl(Astro.site, Astro.url)
const pageTitle = metadataText(title, siteName)
const pageDescription = metadataText(description, defaultDescription, 300)
const canonicalHref = absoluteMetadataUrl(canonicalUrl || Astro.url.pathname, metadataBase)
const socialImageUrl = absoluteMetadataUrl(image || defaultSocialImage, metadataBase)
const socialImageAlt = metadataText(imageAlt, pageTitle, 420)
const twitterTitle = metadataText(pageTitle, siteName, 70)
const twitterDescription = metadataText(pageDescription, defaultDescription, 200)
const isDefaultSocialImage = cleanMetadataText(image, defaultSocialImage) === defaultSocialImage

const imageAssetOrigin = (() => {
  if (!useRemoteImageAssets || !s3AssetBaseUrl) return ''
  try {
    return new URL(s3AssetBaseUrl).origin
  } catch {
    return ''
  }
})()
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {imageAssetOrigin && <link rel="dns-prefetch" href={imageAssetOrigin} />}
    {imageAssetOrigin && <link rel="preconnect" href={imageAssetOrigin} crossorigin />}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {isDefaultSocialImage && <meta property="og:image:width" content="1200" />}
    {isDefaultSocialImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" property="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" property="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" property="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" property="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" property="twitter:image:alt" content={socialImageAlt} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="apple-page-ornament apple-page-ornament--left" aria-hidden="true"></div>
    <div class="apple-page-ornament apple-page-ornament--right" aria-hidden="true"></div>
    <SiteHeader client:load />
    <main>
      <slot />
    </main>
    {!hideFooter && (
      <footer class="source-note site-shell" aria-label="Bronvermelding">
        <p>
          Dit blogarchief is geëxtraheerd uit Daniël Willaeys’ oorspronkelijke blogposts op
          <a href="https://blog.seniorennet.be/fruit/" rel="noreferrer" target="_blank">fruit</a>
          en
          <a href="https://blog.seniorennet.be/fruit2/" rel="noreferrer" target="_blank">fruit2</a>.
        </p>
      </footer>
    )}
  </body>
</html>
