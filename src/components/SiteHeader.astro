---
import { Archive, ChartNoAxesColumn, Database, House, Images, Map, Menu, Search, Shuffle, X } from '@lucide/astro'

const navLink = 'inline-flex min-h-9 items-center gap-2 rounded-full px-3 text-body font-normal tracking-[0.01em] text-obsidian no-underline transition-colors hover:bg-powder hover:text-obsidian'
const randomNavLink = 'inline-grid size-9 place-items-center rounded-full text-obsidian no-underline transition-colors hover:bg-powder hover:text-obsidian'
const mobileNavLink = 'group inline-flex min-h-11 items-center justify-center gap-3 text-center text-[clamp(22px,7vw,28px)] font-medium leading-none tracking-[-0.05em] text-obsidian no-underline transition-colors hover:text-gravel'
const mobileRandomNavLink = 'inline-grid size-11 place-items-center rounded-full border border-chalk bg-pure-surface text-obsidian no-underline shadow-subtle transition-colors hover:bg-powder hover:text-obsidian'

const navItems = [
  { href: '/', label: 'Home', Icon: House },
  { href: '/archive/', label: 'Alle berichten', Icon: Archive },
  { href: '/gallery/', label: 'Beeldarchief', Icon: Images },
  { href: '/atlas/', label: 'Atlas', Icon: Map },
  { href: '/stats/', label: 'Statistieken', Icon: ChartNoAxesColumn },
  { href: '/data/', label: 'Data', Icon: Database },
]
---
<header class="sticky top-0 z-[60] w-full border-b border-chalk bg-eggshell/95 backdrop-blur-md">
  <div class="mx-auto flex min-h-14 w-full max-w-page items-center justify-between gap-4 px-8 py-2 max-md:px-4">
    <a class="flex min-w-0 items-center gap-2 text-body font-medium tracking-[0.01em] text-obsidian no-underline hover:text-obsidian" href="/" aria-label="Naar de startpagina">
      <img class="apple-image brand-apple" src="/apple-assets/apple-1-96.webp" alt="" aria-hidden="true" loading="eager" decoding="async" />
      <span class="truncate whitespace-nowrap py-0.5 font-heading text-[15px] font-normal leading-[1.3] tracking-normal">Blogarchief Daniël Willaeys</span>
    </a>
    <nav class="hidden items-center justify-center gap-1 sm:flex" aria-label="Hoofdnavigatie">
      {navItems.map(({ href, label, Icon }) => (
        <a class={navLink} href={href}><Icon class="size-4 text-slate" aria-hidden="true" />{label}</a>
      ))}
      <a class={randomNavLink} href="/random/" aria-label="Open een willekeurig bericht" title="Willekeurig bericht"><Shuffle class="size-4 text-slate" aria-hidden="true" /></a>
      <a class="inline-flex min-h-9 items-center gap-2 rounded-full bg-obsidian px-4 text-body font-medium tracking-[0.01em] text-eggshell no-underline shadow-blue hover:text-eggshell" href="/search/"><Search class="size-4" aria-hidden="true" />Zoeken</a>
    </nav>
    <button
      id="site-mobile-menu-button"
      class="inline-grid size-10 shrink-0 place-items-center rounded-full border border-chalk bg-pure-surface text-obsidian shadow-subtle sm:hidden"
      type="button"
      aria-label="Menu openen"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <Menu class="size-5" aria-hidden="true" data-menu-open-icon />
      <X class="hidden size-5" aria-hidden="true" data-menu-close-icon />
    </button>
  </div>
</header>

<div id="mobile-navigation" class="fixed inset-x-0 top-14 z-50 hidden h-[calc(100dvh-3.5rem)] overflow-hidden overscroll-none bg-eggshell px-6 py-[clamp(1.5rem,6svh,2.5rem)] sm:hidden" role="dialog" aria-modal="true" aria-label="Hoofdnavigatie">
  <nav class="mx-auto flex w-full max-w-sm flex-col items-center justify-center gap-[clamp(0.75rem,3.5svh,1.75rem)]" aria-label="Mobiele hoofdnavigatie">
    {navItems.map(({ href, label, Icon }) => (
      <a class={mobileNavLink} href={href}>
        <span>{label}</span>
        <Icon class="size-5 text-slate transition-colors group-hover:text-gravel" aria-hidden="true" />
      </a>
    ))}
    <div class="mt-2 h-px w-10 bg-chalk" aria-hidden="true"></div>
    <div class="flex items-center justify-center gap-2">
      <a class={mobileRandomNavLink} href="/random/" aria-label="Open een willekeurig bericht" title="Willekeurig bericht"><Shuffle class="size-5 text-slate" aria-hidden="true" /></a>
      <a class="inline-flex min-h-11 items-center justify-center gap-3 rounded-full bg-obsidian px-7 text-center text-[22px] font-medium leading-none tracking-[-0.035em] text-eggshell no-underline shadow-blue hover:text-eggshell" href="/search/">
        <span>Zoeken</span>
        <Search class="size-5" aria-hidden="true" />
      </a>
    </div>
  </nav>
</div>

<script is:inline>
  (() => {
    const button = document.getElementById('site-mobile-menu-button')
    const menu = document.getElementById('mobile-navigation')
    const openIcon = button?.querySelector('[data-menu-open-icon]')
    const closeIcon = button?.querySelector('[data-menu-close-icon]')
    if (!button || !menu || !openIcon || !closeIcon) return

    let scrollPosition = 0
    const root = document.documentElement
    const body = document.body

    function closeMenu() {
      menu.classList.add('hidden')
      button.setAttribute('aria-expanded', 'false')
      button.setAttribute('aria-label', 'Menu openen')
      openIcon.classList.remove('hidden')
      closeIcon.classList.add('hidden')
      root.classList.remove('mobile-menu-open')
      body.classList.remove('mobile-menu-open')
      body.style.position = ''
      body.style.top = ''
      body.style.left = ''
      body.style.right = ''
      body.style.width = ''
      window.scrollTo({ top: scrollPosition, left: 0, behavior: 'auto' })
    }

    function openMenu() {
      scrollPosition = window.scrollY
      menu.classList.remove('hidden')
      button.setAttribute('aria-expanded', 'true')
      button.setAttribute('aria-label', 'Menu sluiten')
      openIcon.classList.add('hidden')
      closeIcon.classList.remove('hidden')
      root.classList.add('mobile-menu-open')
      body.classList.add('mobile-menu-open')
      body.style.position = 'fixed'
      body.style.top = `-${scrollPosition}px`
      body.style.left = '0'
      body.style.right = '0'
      body.style.width = '100%'
    }

    button.addEventListener('click', () => {
      if (button.getAttribute('aria-expanded') === 'true') closeMenu()
      else openMenu()
    })

    menu.addEventListener('click', (event) => {
      const target = event.target
      if (target instanceof Element && target.closest('a')) closeMenu()
    })
  })()
</script>
