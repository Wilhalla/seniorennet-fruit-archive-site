---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteLoader from '../../components/SiteLoader.astro'
import GalleryApp from '../../components/gallery/GalleryApp'
import initialImages from '../../data/generated/image-index.initial.json'
import galleryGroups from '../../data/generated/gallery-groups.json'
---
<BaseLayout title="Beeldarchief · Blogarchief Daniel Willaeys" description="Chronologisch en semantisch beeldarchief van alle foto’s uit het blogarchief.">
  <SiteLoader id="gallery-hydration-loader" label="Beeldarchief laden" message="beeldarchief laden" />
  <GalleryApp initialImages={initialImages} initialGroups={galleryGroups} client:load />
</BaseLayout>
