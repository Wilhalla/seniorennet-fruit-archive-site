---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import ChronologicalFeed from '../components/ChronologicalFeed'
import portraitDaniel from '../assets/portrait_daniel_willaeys.jpg'
import { aggregatedPostIndex } from '../lib/postIndex'
---
<BaseLayout
  title="Chronologische tijdlijn · Blogarchief Daniël Willaeys"
  description="Alle berichten uit het blogarchief van Daniël Willaeys."
>
  <div id="home-page-loader" class="site-loader site-loader--active" role="status" aria-live="polite" aria-label="Tijdlijn laden">
    <div class="site-loader__mark" aria-hidden="true"></div>
    <div class="site-loader__text">
      <span>Blogarchief Daniël Willaeys</span>
      <small>tijdlijn laden</small>
    </div>
  </div>
  <div class="relative w-full overflow-hidden border-b border-chalk bg-eggshell px-8 py-14 max-md:px-4 md:py-18 lg:py-22">
    <img
      class="apple-image absolute right-[6vw] top-10 hidden w-24 rotate-6 opacity-80 lg:block"
      src="/apple-assets/apple-1-160.webp"
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
    />
    <div class="mx-auto grid max-w-page items-center gap-x-12 gap-y-8 md:grid-cols-[minmax(14rem,0.4fr)_minmax(0,0.6fr)] lg:gap-x-16">
      <figure class="order-2 relative mb-0 grid justify-items-center md:order-1 md:row-span-2 md:justify-self-end">
        <div class="relative isolate">
          <div class="absolute -inset-3 -z-10 rounded-[1.5rem] border border-chalk bg-pure-surface shadow-blue md:-inset-4" aria-hidden="true"></div>
          <Image
            src={portraitDaniel}
            alt="Portret van Daniël Willaeys"
            width={360}
            height={540}
            widths={[180, 240, 320, 360, 480, 640]}
            sizes="(max-width: 767px) 12rem, (max-width: 1023px) 17rem, 20rem"
            layout="constrained"
            format="webp"
            quality="high"
            loading="eager"
            decoding="async"
            class="relative z-10 h-auto w-48 rounded-[1rem] border border-obsidian/10 bg-powder object-cover shadow-[0_28px_70px_rgba(22,28,45,0.18)] md:w-68 lg:w-80"
          />
        </div>
      </figure>

      <div class="order-1 grid justify-items-center text-center md:order-2 md:self-end md:justify-items-start md:text-left">
        <h1
          id="chronology-title"
          class="display-title max-w-3xl max-md:mx-auto"
        >
          Blogarchief Daniël Willaeys
        </h1>
      </div>

      <div class="order-3 max-w-2xl justify-self-center text-center md:col-start-2 md:justify-self-start md:self-start md:text-left">
        <p class="m-0 text-body-lg leading-body-lg text-gravel">
          Bewaarde berichten, foto’s en reacties uit het fruitblogarchief van Daniël Willaeys — nu chronologisch doorzoekbaar en als beeldarchief te verkennen.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-2 md:justify-start">
          <a
            class="inline-flex min-h-9 items-center gap-2 rounded-full bg-obsidian px-4 text-body font-medium text-eggshell no-underline shadow-blue hover:text-eggshell"
            href="/search/"
          >
            <svg class="size-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            Zoeken
          </a>
          <a
            class="inline-flex min-h-9 items-center gap-2 rounded-full border border-chalk bg-pure-surface px-3 text-body font-medium text-obsidian no-underline shadow-blue hover:text-obsidian"
            href="/gallery/"
          >
            <svg class="size-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
              <circle cx="9" cy="9" r="2"></circle>
              <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path>
            </svg>
            Beeldarchief
          </a>
        </div>
      </div>
    </div>
  </div>
  <ChronologicalFeed posts={aggregatedPostIndex} />
  <script is:inline>
    (() => {
      const loader = document.getElementById('home-page-loader')
      if (!loader) return
      const showDelayMs = 180
      const minVisibleMs = 80
      const fadeMs = 140
      const now = performance.now()
      if (now < showDelayMs) {
        loader.remove()
        return
      }
      window.setTimeout(() => {
        loader.classList.add('site-loader--dismissed')
        window.setTimeout(() => loader.remove(), fadeMs)
      }, Math.max(0, showDelayMs + minVisibleMs - now))
    })()
  </script>
</BaseLayout>
