---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteLoader from '../../components/SiteLoader.astro'
import StatsDashboard from '../../components/stats/StatsDashboard'
import { buildArchiveStatsData } from '../../lib/archiveStats'

const stats = buildArchiveStatsData()
---
<BaseLayout
  title="Statistieken · Blogarchief Daniel Willaeys"
  description="Data-inzichten over berichten, beelden, reacties, ritme en thema’s in het blogarchief van Daniël Willaeys."
>
  <SiteLoader id="stats-hydration-loader" label="Statistieken laden" message="statistieken laden" />
  <StatsDashboard stats={stats} client:load />
</BaseLayout>
