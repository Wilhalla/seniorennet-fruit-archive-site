---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteLoader from '../../components/SiteLoader.astro'
import ArchiveVirtualList from '../../components/ArchiveVirtualList'
import { archiveStats } from '../../lib/postIndex'
---
<BaseLayout title="Alle berichten · Blogarchief Daniel Willaeys">
  <SiteLoader id="archive-hydration-loader" label="Archief laden" message="archief laden" />
  <section class="site-shell relative overflow-hidden py-16 md:py-20">
    <img class="apple-image section-apple absolute right-8 top-10 hidden rotate-6 md:block" src="/apple-assets/apple-2-160.webp" alt="" aria-hidden="true" loading="eager" decoding="async" />
    <h1 class="display-title">Alle berichten</h1>
    <p class="section-kicker">
      {archiveStats.postCount.toLocaleString('nl-BE')} berichten.
    </p>
  </section>
  <ArchiveVirtualList client:load />
</BaseLayout>
